{
  "name": "habit-tracker-backend",
  "description": "The backend for a local-first habit tracker web app that optionally syncs your data across devices.",
  "version": "1.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/flow145/habit-tracker-backend#readme",
  "bugs": "https://github.com/flow145/habit-tracker-backend/issues",
  "repository": "git@github.com:flow145/habit-tracker-backend.git",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "staging": "APP_STAGE=staging node src/main.ts",
    "prod": "APP_STAGE=prod node src/main.ts",
    "db:up": "docker compose --env-file .env.development up -d --wait db",
    "db:down": "docker compose --env-file .env.development down db",
    "format": "biome format --reporter=summary",
    "format:fix": "pnpm format --write",
    "check": "biome check --reporter=summary",
    "check:fix": "pnpm check --write",
    "typecheck": "tsc",
    "test": "APP_STAGE=test vitest run",
    "test:watch": "APP_STAGE=test vitest",
    "test:coverage": "APP_STAGE=test vitest run --coverage"
  },
  "dependencies": {
    "compression": "~1.8.2",
    "cookie-parser": "~1.4.7",
    "cors": "~2.8.6",
    "custom-env": "~2.0.6",
    "express": "~5.3.0",
    "express-rate-limit": "~8.7.2",
    "helmet": "~8.3.0",
    "http-status-codes": "~2.3.0",
    "pino": "~10.4.0",
    "pino-http": "~11.0.0",
    "postgres": "~4.0.0",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "~21.2.4",
    "@commitlint/config-conventional": "~21.2.4",
    "@types/compression": "~1.8.1",
    "@types/cookie-parser": "~1.4.10",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.6",
    "@types/node": "~26.6.6",
    "@types/pg": "~8.23.1",
    "@types/supertest": "~7.2.1",
    "lefthook": "~2.2.2",
    "pino-pretty": "~13.2.0",
    "supertest": "~7.3.1",
    "typescript": "~7.0.2",
    "vitest": "~5.0.5"
  },
  "imports": {
    "#/*": "./src/*"
  }
}
